# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Project settings → API). The anon/publishable key is safe
# in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS: never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Random secret used to hash invite codes and encrypt them for the
# admin list. Generate with: openssl rand -base64 32
# Changing it invalidates every existing unused code.
INVITE_CODE_SECRET=
# Codes look like PMB-XXXX-XXXX.
INVITE_CODE_PREFIX=PMB

# Server only. AI tutor.
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-opus-5-5
# Messages per student per hour.
TUTOR_MESSAGES_PER_HOUR=30
# Longest conversation (user + tutor messages) before "start a new chat".
TUTOR_MAX_MESSAGES=24
# Longest single question, in characters.
TUTOR_MAX_CHARS=4000
